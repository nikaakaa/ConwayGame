/* 逐层展开的极简界面：图标与棋盘同为方块，只有暗灰与白两种状态，没有边框。
   工程使用线性色彩空间，低透明度在屏幕上会偏亮，数值按截图调整。 */

.life-cell-icon {
    --cell-color: rgba(255, 255, 255, 0.55);
}

.life-dock {
    position: absolute;
    left: 10px;
    top: 10px;
    flex-direction: row;
    align-items: center;
}

.life-dock__level {
    flex-direction: row;
    margin-left: 6px;
}

.life-dock__item {
    width: 48px;
    height: 48px;
    padding: 12px;
}

.life-dock__icon {
    flex-grow: 1;
}

.life-dock__item:hover > .life-cell-icon,
.life-dock__item--on > .life-cell-icon,
.life-dock__item--open > .life-cell-icon {
    --cell-color: rgb(255, 255, 255);
}

/* 滑翔机是常驻标识：暂停时半亮，运行时全亮。 */
.life-dock__glider > .life-cell-icon {
    --cell-color: rgba(255, 255, 255, 0.7);
}

.life-dock__glider.life-dock__item--on > .life-cell-icon,
.life-dock__glider:hover > .life-cell-icon {
    --cell-color: rgb(255, 255, 255);
}

/* 有二级的图标右下角一个小点，点它或右键可固定展开。 */
.life-dock__dot {
    position: absolute;
    right: 5px;
    bottom: 5px;
    width: 3px;
    height: 3px;
    background-color: rgba(255, 255, 255, 0.35);
}

.life-dock__status {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    font-size: 15px;
    color: rgb(255, 255, 255);
}

.life-dock__status-key {
    margin: 0 6px 0 8px;
    padding: 0;
    color: rgba(255, 255, 255, 0.5);
}

.life-dock__toast {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
}

/* 悬停提示与操作结果共用图标行末尾的位置，从不出现在光标下方。 */
.life-dock__hint {
    margin: 0 0 0 12px;
    padding: 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
}

.life-dock__sub {
    position: absolute;
    flex-direction: row;
    align-items: center;
    padding: 0 2px;
    background-color: rgba(0, 0, 0, 0.88);
}

.life-dock__speed {
    min-width: 56px;
    margin: 0;
    padding: 0 4px;
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
}

.life-dock__tip {
    position: absolute;
    margin: 0;
    padding: 3px 8px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.9);
    background-color: rgba(0, 0, 0, 0.88);
}

/* 选区操作条浮在选区右下角；棋盘上可能是白色细胞，所以给黑底和一圈细线。 */
.life-dock__selection {
    position: absolute;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.18);
}

/* 快捷键帮助：居中浮层，两列键位。 */
.life-help-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
}

.life-help {
    padding: 20px 26px 16px 26px;
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
}

.life-help__row {
    flex-direction: row;
    height: 30px;
    align-items: center;
}

.life-help__key {
    width: 96px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    color: rgb(255, 255, 255);
}

.life-help__text {
    width: 180px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
}

.life-help__footer {
    margin: 14px 0 0 0;
    padding: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.45);
}

/* 开始界面：全屏黑底，背景是暗处演化的枪，中间滑翔机标志与菜单，选中项反白。 */
.life-start {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.life-start__background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.08);
}

.life-start__center {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.life-start__logo {
    width: 84px;
    height: 84px;
    margin-bottom: 36px;
    --cell-color: rgb(255, 255, 255);
}

.life-start__menu {
    min-width: 200px;
}

.life-start__item {
    height: 38px;
    margin: 2px 0;
    padding: 0 24px;
    font-size: 17px;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.6);
}

.life-start__item--on {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

/* 载入时替换菜单的一行字，与菜单项同高，避免标志上下跳动。 */
.life-start__loading {
    height: 38px;
    margin: 2px 0;
    padding: 0;
    font-size: 15px;
    letter-spacing: 6px;
    -unity-text-align: middle-center;
    color: rgba(255, 255, 255, 0.45);
}
