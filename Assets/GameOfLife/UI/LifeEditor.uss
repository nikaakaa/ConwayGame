/* 黑白、方格、细线：与棋盘同一套语言。工程使用线性色彩空间，低透明度在屏幕上会偏亮。 */

.life-toolbar {
    position: absolute;
    left: 14px;
    top: 14px;
    width: 280px;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.life-header {
    flex-direction: row;
    align-items: center;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.life-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.life-toolbar > .life-row:last-child {
    margin-bottom: 0;
}

.life-spacer {
    flex-grow: 1;
}

/* 3×3 滑翔机，随代数播放四个相位。 */
.life-glider {
    flex-shrink: 0;
}

.life-glider-row {
    flex-direction: row;
}

.life-glider-cell {
    width: 5px;
    height: 5px;
    margin: 0 1px 1px 0;
    background-color: rgba(255, 255, 255, 0.025);
}

.life-glider-cell--alive {
    background-color: rgb(255, 255, 255);
}

.life-generation {
    margin: 0 0 0 10px;
    padding: 0;
    font-size: 20px;
}

/* 细胞数前的小方块即“细胞”。 */
.life-population-cell {
    width: 5px;
    height: 5px;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.35);
}

.life-population {
    margin: 0 12px 0 0;
    padding: 0;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
}

/* 按钮：细线方框；悬停加亮；选中或运行中反白。 */
.life-toolbar .unity-button {
    height: 26px;
    margin: 0 6px 0 0;
    padding: 0 8px;
    min-width: 0;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.75);
    -unity-text-align: middle-center;
    font-size: 12px;
}

.life-toolbar .unity-button:hover {
    border-color: rgba(255, 255, 255, 0.6);
    color: rgb(255, 255, 255);
}

.life-toolbar .unity-button:active {
    background-color: rgba(255, 255, 255, 0.06);
}

.life-toolbar .unity-button.life-button--on {
    border-color: rgb(255, 255, 255);
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    -unity-font-style: bold;
}

.life-toolbar .unity-button:disabled {
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.15);
    opacity: 1;
}

.life-button--grow {
    flex-grow: 1;
    flex-basis: 0;
}

.life-button--square {
    width: 26px;
    padding: 0;
}

.life-header > .unity-button {
    height: 22px;
    width: 22px;
    margin: 0;
    border-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.35);
}

.life-row > .unity-button:last-child {
    margin-right: 0;
}

/* 输入框与下拉：同样的细线方框。 */
.life-toolbar .unity-base-field {
    margin: 0 6px 0 0;
    min-width: 0;
}

.life-toolbar .unity-base-field__input {
    height: 26px;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.life-toolbar .unity-base-field:hover > .unity-base-field__input {
    border-color: rgba(255, 255, 255, 0.6);
}

.life-toolbar .unity-base-field .unity-text-element {
    color: rgb(255, 255, 255);
}

.life-toolbar .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.5);
    width: 8px;
    height: 8px;
}

.life-speed {
    width: 52px;
    flex-shrink: 0;
}

.life-speed .unity-base-field__input {
    -unity-text-align: middle-center;
    padding: 0;
}

/* 隐藏工具栏后左上角只留滑翔机，点击恢复。 */
.life-chip {
    position: absolute;
    left: 14px;
    top: 14px;
    padding: 9px 8px 8px 9px;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.life-chip:hover {
    border-color: rgba(255, 255, 255, 0.6);
}

/* 操作结果的短提示，浮在工具栏下方，约 2 秒后消失。 */
.life-toast {
    position: absolute;
    top: 100%;
    left: -1px;
    margin-top: 6px;
    padding: 5px 10px;
    background-color: rgba(0, 0, 0, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
}

/* 结构下拉菜单挂在面板根节点上，不在 .life-toolbar 内，单独设置为同一套黑白样式。 */
.unity-base-dropdown__container-outer {
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-radius: 0;
    border-color: rgba(255, 255, 255, 0.25);
    padding: 4px 0;
}

.unity-base-dropdown__container-inner {
    background-color: rgb(0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.unity-base-dropdown__item {
    height: 24px;
    padding: 0 10px 0 4px;
    background-color: rgb(0, 0, 0);
    color: rgba(255, 255, 255, 0.7);
}

.unity-base-dropdown__item:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.unity-base-dropdown__item .unity-base-dropdown__label {
    color: inherit;
    font-size: 12px;
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.unity-base-dropdown__item:hover .unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.unity-base-dropdown__container-outer .unity-scroller--horizontal {
    display: none;
}
